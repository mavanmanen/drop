# ==============================================================================
# Production Environment Configuration for Drop (.env.prod)
# Copy this file to .env.prod and set secure values:
#   cp .env.prod.example .env.prod
#
# Usage:
#   docker compose -f docker-compose.prod.yml up -d
# ==============================================================================

# Single admin account configuration (MUST CHANGE FOR PRODUCTION)
DROP_ADMIN_USERNAME=admin
DROP_ADMIN_PASSWORD=change-me-to-a-secure-password

# JWT secret key for signing tokens (MUST be at least 32 characters in production)
DROP_JWT_SECRET=replace-with-a-random-32-char-secret-string

# Storage and directory paths inside container
DROP_DATA_DIR=/data
DROP_INGEST_PATH=/data/ingest
DROP_STORAGE_PATH=/data/clips

# Database configuration: 'sqlite' (default) or 'postgres'
DROP_DB_PROVIDER=sqlite
DROP_DB_PATH=/data/db/drop.db

# Default visibility for automatically ingested clips ('public', 'unlisted', or 'private')
DROP_INGEST_DEFAULT_VISIBILITY=public

# Optional PostgreSQL configuration (used if DROP_DB_PROVIDER=postgres)
# DROP_POSTGRES_HOST=postgres
# DROP_POSTGRES_PORT=5432
# DROP_POSTGRES_DB=drop
# DROP_POSTGRES_USER=drop
# DROP_POSTGRES_PASSWORD=your-secure-postgres-password
# DROP_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=drop;Username=drop;Password=your-secure-postgres-password
