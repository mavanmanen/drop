# ==============================================================================
# Development Environment Configuration for Drop (.env)
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Single admin account configuration
DROP_ADMIN_USERNAME=admin
DROP_ADMIN_PASSWORD=change-me-promptly

# JWT secret key for signing tokens (minimum 32 characters recommended)
DROP_JWT_SECRET=drop_super_secret_gaming_clips_key_2026_dev_env_only!

# Storage and directory paths inside container
DROP_DATA_DIR=/data
DROP_INGEST_PATH=/data/ingest
DROP_STORAGE_PATH=/data/clips

# Database configuration: 'sqlite' (default) or 'postgres'
DROP_DB_PROVIDER=sqlite
DROP_DB_PATH=/data/db/drop.db

# Default visibility for automatically ingested clips ('public', 'unlisted', or 'private')
DROP_INGEST_DEFAULT_VISIBILITY=public

# Optional PostgreSQL configuration (used if DROP_DB_PROVIDER=postgres)
# DROP_POSTGRES_HOST=postgres
# DROP_POSTGRES_PORT=5432
# DROP_POSTGRES_DB=drop
# DROP_POSTGRES_USER=drop
# DROP_POSTGRES_PASSWORD=droppassword
# DROP_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=drop;Username=drop;Password=droppassword

# Google Gemini API configuration for AI Video Analysis (optional)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.8-flash
